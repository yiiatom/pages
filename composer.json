{
    "name": "yiiatom/pages",
    "description": "Hierarchical static pages management module for Atom CMS",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2",
        "yiiatom/cms": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Atom\\Pages\\": "src/"
        }
    },
    "extra": {
        "config-plugin": {
            "params": "config/params.php",
            "events": "config/events.php",
            "routes": "config/routes.php"
        }
    }
}